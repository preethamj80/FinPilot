# Local development defaults to the existing SQLite database.
FINPILOT_ENV=development

# Leave both blank for local SQLite. Set both for a persistent Turso database.
# Use a new, empty cloud database for the public demo; never use local finance.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional when using a custom production domain. On Render, the onrender.com
# origin is added from RENDER_EXTERNAL_URL automatically.
PUBLIC_APP_ORIGIN=
